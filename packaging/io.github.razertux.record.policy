<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>RazerTux</vendor>
  <vendor_url>https://github.com/anoraknophobia/RazerTux</vendor_url>
  <action id="io.github.razertux.record">
    <description>Record a Razer device for a device report</description>
    <message>Authentication is required to read a Razer device for a device report (read-only commands, a temporary light test and button presses of that device only)</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/razertux/razertux-record-helper</annotate>
  </action>
</policyconfig>
