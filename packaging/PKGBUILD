# Maintainer: anoraknophobia
# Baut aus dem lokalen Git-Checkout (ein Verzeichnis ueber packaging/), kein Netzwerk noetig.
pkgname=naga-config
pkgver=0.1.0
pkgrel=1
pkgdesc='Linux replacement for Razer Synapse for the Razer Naga V2 Pro'
arch=('any')
url='https://github.com/anoraknophobia/naga-config'
license=('GPL-2.0-or-later')
depends=(python python-evdev pyside6 python-pyudev python-dbus-next)
makedepends=(python-build python-installer python-wheel python-setuptools)
conflicts=(openrazer-daemon openrazer-driver-dkms)
source=()

prepare() {
  # Saubere Kopie des Checkouts, damit build/ und egg-info nicht im Repo landen
  rm -rf "$srcdir/$pkgname"
  mkdir -p "$srcdir/$pkgname"
  cp -r "$startdir/../naga_config" "$startdir/../pyproject.toml" \
        "$startdir/../README.md" "$startdir/../LICENSE" "$srcdir/$pkgname/"
  find "$srcdir/$pkgname" -name __pycache__ -prune -exec rm -rf {} +
}

build() {
  cd "$srcdir/$pkgname"
  python -m build --wheel --no-isolation
}

package() {
  cd "$srcdir/$pkgname"
  python -m installer --destdir="$pkgdir" dist/*.whl

  local p="$startdir"
  install -Dm644 "$p/70-naga-config.rules" "$pkgdir/usr/lib/udev/rules.d/70-naga-config.rules"
  install -Dm644 "$p/naga-configd.service" "$pkgdir/usr/lib/systemd/user/naga-configd.service"
  install -Dm644 "$p/io.github.nagaconfig.service" "$pkgdir/usr/share/dbus-1/services/io.github.nagaconfig.service"
  install -Dm644 "$p/naga-config.desktop" "$pkgdir/usr/share/applications/naga-config.desktop"
  install -Dm644 "$p/naga-config-tray.desktop" "$pkgdir/etc/xdg/autostart/naga-config-tray.desktop"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
