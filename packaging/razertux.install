# pacman runs these hooks as root: they can only print what the user has to do,
# user services must be switched by the user (systemctl --user).

_razertux_switch_hint() {
  echo ':: RazerTux: Dienst als normaler Benutzer (nicht root) umstellen bzw. aktivieren:'
  echo ':: RazerTux: switch/enable the service as your normal user (not root):'
  echo '   systemctl --user disable --now naga-configd.service 2>/dev/null; systemctl --user enable --now razertuxd.service'
  echo ':: Eine vorhandene ~/.config/naga-config wird beim ersten Start nach ~/.config/razertux kopiert.'
}

post_install() {
  _razertux_switch_hint
}

post_upgrade() {
  _razertux_switch_hint
}
