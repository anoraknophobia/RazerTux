[Unit]
Description=RazerTux Daemon (Razer Naga V2 Pro)
Documentation=file:///usr/share/doc/razertux/README.md
# Start with the desktop session: by then logind has applied the seat ACLs to
# /dev/uinput and the mouse's input nodes (the daemon still retries briefly).
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=dbus
BusName=io.github.razertux
ExecStart=/usr/bin/razertuxd
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
